# Copy to .env and fill in the values:  cp .env.example .env

# --- OpenHands -----------------------------------------------------------
# Image tag to deploy (https://github.com/OpenHands/openhands/pkgs/container/agent-canvas)
OPENHANDS_VERSION=1.16.0
# Host address/IP to bind the web UI on
OPENHANDS_BIND=0.0.0.0
OPENHANDS_PORT=8000
# Host directory for OpenHands state (settings, LLM profiles, conversations)
OPENHANDS_DATA_DIR=./data/openhands
# Host directory the agent can read/write (mounted at /projects in its sandbox)
PROJECTS_DIR=./projects

# --- GLM (Zhipu AI) ------------------------------------------------------
# API key from https://open.bigmodel.cn (China) or https://z.ai (international)
GLM_API_KEY=
# Pick the endpoint matching your account type:
#   Pay-as-you-go (China):          https://open.bigmodel.cn/api/paas/v4
#   Coding plan (China):            https://open.bigmodel.cn/api/coding/paas/v4
#   Pay-as-you-go (international):  https://api.z.ai/api/paas/v4
#   Coding plan (international):    https://api.z.ai/api/coding/paas/v4
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM model name, e.g. glm-4.6, glm-4.5, glm-4.5-air
GLM_MODEL=glm-4.6

# --- Reverse proxy (see apache/openhands.conf) ----------------------------
# Public origin of the instance; empty or commented = direct access.
# Also add the origin to any firewall/allow-list rules you maintain.
#OH_WEB_URL=https://openhands.example.com

# --- Secrets (generate with: openssl rand -base64 32) --------------------
# API key required to talk to the canvas/agent-server API from outside localhost
LOCAL_BACKEND_API_KEY=
# Key used to encrypt settings/secrets at rest
OH_SECRET_KEY=
